{
  "expo": {
    "name": "Medilink",
    "slug": "medilink-prototype",
    "version": "1.0.0",
    "scheme": "medilink",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inzint.medilink.prototype",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.medilink.prototype",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#2E1A47"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/me-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#2E1A47"
        }
      ],
      "expo-font",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d72a4ae8-028b-4b6a-a349-c88da111c89a"
      }
    },
    "owner": "jaiinzint"
  }
}
